# DOMAIN: tên miền thật để Caddy tự lấy chứng chỉ Let's Encrypt; "localhost" thì dùng chứng chỉ nội bộ
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy backend:3000
	}
	handle /socket.io/* {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		# File build có mã băm trong tên: cache dài hạn; index.html luôn lấy mới
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
