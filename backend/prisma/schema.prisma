generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  fullName      String         @map("full_name")
  role          Role           @default(STUDENT)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  refreshTokens RefreshToken[]
  courses       Course[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Các token xoay vòng từ cùng một lần đăng nhập chung familyId,
  // để khi phát hiện token cũ bị dùng lại thì thu hồi cả chuỗi.
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum LessonType {
  VIDEO
  READING
}

model Course {
  id           String    @id @default(uuid()) @db.Uuid
  instructorId String    @map("instructor_id") @db.Uuid
  slug         String    @unique
  title        String
  description  String    @default("")
  thumbnailUrl String?   @map("thumbnail_url")
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  instructor   User      @relation(fields: [instructorId], references: [id])
  chapters     Chapter[]

  @@index([instructorId])
  @@index([published])
  @@map("courses")
}

model Chapter {
  id       String   @id @default(uuid()) @db.Uuid
  courseId String   @map("course_id") @db.Uuid
  title    String
  position Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId, position])
  @@map("chapters")
}

model Lesson {
  id          String       @id @default(uuid()) @db.Uuid
  chapterId   String       @map("chapter_id") @db.Uuid
  type        LessonType
  title       String
  // VIDEO: URL YouTube hoặc file mp4; READING: để trống
  videoUrl    String?      @map("video_url")
  // Nội dung markdown: bài đọc, hoặc ghi chú kèm video
  content     String       @default("")
  durationSec Int          @default(0) @map("duration_sec")
  position    Int
  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([chapterId, position])
  @@map("lessons")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  fileName   String   @map("file_name")
  // Tên file lưu trên đĩa (ngẫu nhiên), không phải tên người dùng upload
  storageKey String   @unique @map("storage_key")
  mimeType   String   @map("mime_type")
  size       Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("attachments")
}
