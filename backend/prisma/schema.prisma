generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique
  passwordHash  String            @map("password_hash")
  fullName      String            @map("full_name")
  role          Role              @default(STUDENT)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  refreshTokens RefreshToken[]
  courses       Course[]
  enrollments   Enrollment[]
  learningPaths LearningPath[]
  questions     Question[]
  attempts      PracticeAttempt[]
  examsCreated  Exam[]
  candidacies   ExamCandidate[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Các token xoay vòng từ cùng một lần đăng nhập chung familyId,
  // để khi phát hiện token cũ bị dùng lại thì thu hồi cả chuỗi.
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum LessonType {
  VIDEO
  READING
}

model Course {
  id           String               @id @default(uuid()) @db.Uuid
  instructorId String               @map("instructor_id") @db.Uuid
  slug         String               @unique
  title        String
  description  String               @default("")
  thumbnailUrl String?              @map("thumbnail_url")
  published    Boolean              @default(false)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  instructor   User                 @relation(fields: [instructorId], references: [id])
  chapters     Chapter[]
  enrollments  Enrollment[]
  paths        LearningPathCourse[]
  topics       Topic[]
  questions    Question[]
  blueprints   ExamBlueprint[]
  attempts     PracticeAttempt[]
  exams        Exam[]

  @@index([instructorId])
  @@index([published])
  @@map("courses")
}

model Chapter {
  id       String   @id @default(uuid()) @db.Uuid
  courseId String   @map("course_id") @db.Uuid
  title    String
  position Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId, position])
  @@map("chapters")
}

model Lesson {
  id          String           @id @default(uuid()) @db.Uuid
  chapterId   String           @map("chapter_id") @db.Uuid
  type        LessonType
  title       String
  // VIDEO: URL YouTube hoặc file mp4; READING: để trống
  videoUrl    String?          @map("video_url")
  // Nội dung markdown: bài đọc, hoặc ghi chú kèm video
  content     String           @default("")
  durationSec Int              @default(0) @map("duration_sec")
  position    Int
  chapter     Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  progress    LessonProgress[]
  lastOf      Enrollment[]
  questions   Question[]

  @@index([chapterId, position])
  @@map("lessons")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  fileName   String   @map("file_name")
  // Tên file lưu trên đĩa (ngẫu nhiên), không phải tên người dùng upload
  storageKey String   @unique @map("storage_key")
  mimeType   String   @map("mime_type")
  size       Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("attachments")
}

model Enrollment {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  courseId     String           @map("course_id") @db.Uuid
  // Bài học mở gần nhất, dùng cho nút "Học tiếp"
  lastLessonId String?          @map("last_lesson_id") @db.Uuid
  enrolledAt   DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lastLesson   Lesson?          @relation(fields: [lastLessonId], references: [id], onDelete: SetNull)
  progress     LessonProgress[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  enrollmentId String     @map("enrollment_id") @db.Uuid
  lessonId     String     @map("lesson_id") @db.Uuid
  // Vị trí xem video gần nhất (giây), để mở lại đúng chỗ
  positionSec  Int        @default(0) @map("position_sec")
  completedAt  DateTime?  @map("completed_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model LearningPath {
  id          String               @id @default(uuid()) @db.Uuid
  createdById String               @map("created_by_id") @db.Uuid
  slug        String               @unique
  title       String
  description String               @default("")
  published   Boolean              @default(false)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   User                 @relation(fields: [createdById], references: [id])
  courses     LearningPathCourse[]

  @@index([createdById])
  @@map("learning_paths")
}

model LearningPathCourse {
  pathId   String       @map("path_id") @db.Uuid
  courseId String       @map("course_id") @db.Uuid
  position Int
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([pathId, courseId])
  @@index([courseId])
  @@map("learning_path_courses")
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  MANUAL
  IMPORT
  AI
}

enum QuestionStatus {
  // DRAFT: câu AI đề xuất, chờ giảng viên duyệt (giai đoạn 4)
  DRAFT
  ACTIVE
  ARCHIVED
}

model Topic {
  id        String          @id @default(uuid()) @db.Uuid
  courseId  String          @map("course_id") @db.Uuid
  name      String
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  rules     BlueprintRule[]
  examRules ExamRule[]

  @@unique([courseId, name])
  @@map("topics")
}

model Question {
  id          String           @id @default(uuid()) @db.Uuid
  courseId    String           @map("course_id") @db.Uuid
  topicId     String           @map("topic_id") @db.Uuid
  // Bài học liên quan, để AI giải thích dựa trên nội dung bài (giai đoạn 4)
  lessonId    String?          @map("lesson_id") @db.Uuid
  createdById String           @map("created_by_id") @db.Uuid
  type        QuestionType
  difficulty  Difficulty
  content     String
  explanation String           @default("")
  source      QuestionSource   @default(MANUAL)
  status      QuestionStatus   @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic       Topic            @relation(fields: [topicId], references: [id], onDelete: NoAction)
  lesson      Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy   User             @relation(fields: [createdById], references: [id])
  options     QuestionOption[]
  answers     PracticeAnswer[]

  @@index([courseId, status])
  @@index([topicId, difficulty])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  content    String
  // Không bao giờ gửi xuống client khi đang ôn tập/thi
  isCorrect  Boolean  @map("is_correct")
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

// Ma trận đề thi thử: mỗi quy tắc lấy N câu theo chủ đề + độ khó
model ExamBlueprint {
  id          String            @id @default(uuid()) @db.Uuid
  courseId    String            @map("course_id") @db.Uuid
  title       String
  durationSec Int               @map("duration_sec")
  published   Boolean           @default(false)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rules       BlueprintRule[]
  attempts    PracticeAttempt[]

  @@index([courseId])
  @@map("exam_blueprints")
}

model BlueprintRule {
  blueprintId String        @map("blueprint_id") @db.Uuid
  topicId     String        @map("topic_id") @db.Uuid
  difficulty  Difficulty
  count       Int
  blueprint   ExamBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  topic       Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([blueprintId, topicId, difficulty])
  @@map("blueprint_rules")
}

enum PracticeMode {
  // Ôn tập theo chủ đề: trả lời câu nào chấm câu đó, xem giải thích ngay
  TOPIC
  // Thi thử theo ma trận: tính giờ, chỉ chấm khi nộp
  MOCK
}

model PracticeAttempt {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  courseId     String           @map("course_id") @db.Uuid
  blueprintId  String?          @map("blueprint_id") @db.Uuid
  mode         PracticeMode
  title        String
  startedAt    DateTime         @default(now()) @map("started_at") @db.Timestamptz
  // Chỉ có với thi thử; server giữ giờ, client chỉ hiển thị
  deadlineAt   DateTime?        @map("deadline_at") @db.Timestamptz
  submittedAt  DateTime?        @map("submitted_at") @db.Timestamptz
  totalCount   Int              @map("total_count")
  correctCount Int              @default(0) @map("correct_count")
  // Thang điểm 10, làm tròn 2 chữ số
  score        Float?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  blueprint    ExamBlueprint?   @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  answers      PracticeAnswer[]

  @@index([userId, courseId, startedAt])
  @@map("practice_attempts")
}

model PracticeAnswer {
  attemptId         String          @map("attempt_id") @db.Uuid
  questionId        String          @map("question_id") @db.Uuid
  position          Int
  // Thứ tự phương án đã xáo cho lần làm này
  optionOrder       String[]        @map("option_order") @db.Uuid
  selectedOptionIds String[]        @default([]) @map("selected_option_ids") @db.Uuid
  // null = chưa chấm
  isCorrect         Boolean?        @map("is_correct")
  answeredAt        DateTime?       @map("answered_at") @db.Timestamptz
  attempt           PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([attemptId, questionId])
  @@index([questionId])
  @@map("practice_answers")
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

enum CandidateVerdict {
  VALID
  SUSPICIOUS
  VIOLATION
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

/**
 * Kỳ thi chính thức: cửa sổ mở/đóng, thời lượng, ma trận đề chép từ đề thi thử.
 */
model Exam {
  id             String          @id @default(uuid()) @db.Uuid
  courseId       String          @map("course_id") @db.Uuid
  createdById    String          @map("created_by_id") @db.Uuid
  title          String
  opensAt        DateTime        @map("opens_at") @db.Timestamptz
  closesAt       DateTime        @map("closes_at") @db.Timestamptz
  durationSec    Int             @map("duration_sec")
  shuffleOptions Boolean         @default(true) @map("shuffle_options")
  status         ExamStatus      @default(DRAFT)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy      User            @relation(fields: [createdById], references: [id])
  rules          ExamRule[]
  candidates     ExamCandidate[]

  @@index([courseId])
  @@map("exams")
}

/**
 * Ma trận đề đã chép, để sửa đề thi thử gốc không ảnh hưởng kỳ thi.
 */
model ExamRule {
  examId     String     @map("exam_id") @db.Uuid
  topicId    String     @map("topic_id") @db.Uuid
  difficulty Difficulty
  count      Int
  exam       Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([examId, topicId, difficulty])
  @@map("exam_rules")
}

model ExamCandidate {
  id      String           @id @default(uuid()) @db.Uuid
  examId  String           @map("exam_id") @db.Uuid
  userId  String           @map("user_id") @db.Uuid
  verdict CandidateVerdict @default(VALID)
  addedAt DateTime         @default(now()) @map("added_at") @db.Timestamptz
  exam    Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt ExamAttempt?

  @@unique([examId, userId])
  @@map("exam_candidates")
}

/**
 * Mỗi thí sinh một lượt thi; server giữ giờ qua deadlineAt.
 */
model ExamAttempt {
  id           String            @id @default(uuid()) @db.Uuid
  candidateId  String            @unique @map("candidate_id") @db.Uuid
  status       ExamAttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime          @default(now()) @map("started_at") @db.Timestamptz
  // min(bắt đầu + thời lượng, giờ đóng kỳ thi)
  deadlineAt   DateTime          @map("deadline_at") @db.Timestamptz
  submittedAt  DateTime?         @map("submitted_at") @db.Timestamptz
  totalCount   Int               @map("total_count")
  correctCount Int?              @map("correct_count")
  score        Float?
  candidate    ExamCandidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  questions    AttemptQuestion[]

  @@map("exam_attempts")
}

/**
 * Đề đã đóng băng: chép nội dung câu hỏi và phương án (kèm đáp án đúng)
 * lúc bắt đầu, nên sửa ngân hàng câu hỏi không ảnh hưởng bài đang thi.
 */
model AttemptQuestion {
  attemptId         String      @map("attempt_id") @db.Uuid
  position          Int
  questionId        String      @map("question_id") @db.Uuid
  // { type, content, options: [{ id, content, isCorrect }] } theo thứ tự hiển thị
  snapshot          Json
  selectedOptionIds String[]    @default([]) @map("selected_option_ids") @db.Uuid
  savedAt           DateTime?   @map("saved_at") @db.Timestamptz
  isCorrect         Boolean?    @map("is_correct")
  attempt           ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, position])
  @@unique([attemptId, questionId])
  @@map("attempt_questions")
}
